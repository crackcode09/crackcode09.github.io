---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Label from '../components/Label.astro';
import Button from '../components/Button.astro';
import Chip from '../components/Chip.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('writing');
const recentPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

const allProjects = await getCollection('projects', ({ data }) => data.featured && data.status !== 'draft');
const featuredProjects = allProjects
  .sort((a, b) => {
    const order = ['live', 'coming-soon'];
    return order.indexOf(a.data.status) - order.indexOf(b.data.status);
  })
  .slice(0, 3);

const liftColors: Record<string, string> = { red: 'var(--blood)', green: 'var(--signal)', gold: 'var(--gold)', default: 'var(--ink)' };

const social = [
  { label: 'GitHub', icon: 'github', href: 'https://github.com/crackcode09' },
  { label: 'LinkedIn', icon: 'linkedin', href: 'https://www.linkedin.com/in/dnidhin97/' },
  { label: 'Email hello@nidhy.dev', icon: 'envelope', href: 'mailto:hello@nidhy.dev' },
] as const;

// Hero build log: the DMAIC method as a terminal, padded into columns.
const logSteps = [
  ['define', 'scope the problem'],
  ['measure', 'baseline the process'],
  ['analyze', 'find the root cause'],
  ['improve', 'build the tool'],
  ['control', 'keep it fixed'],
  ['ship', 'write it up in public'],
].map(([step, what]) => ({ step: step.padEnd(8), what: `${what} `.padEnd(24, '.') }));
---

<Base>
  <Header />

  <!-- Hero -->
  <section id="top" class="hero">
    <script is:inline>
      // Runs before the hero paints. The intro plays once per visit (session) and never
      // with reduced motion. If the motion script hasn't started within 1.5s (blocked,
      // slow or unsupported), the finished hero is shown instead.
      (function () {
        var d = document.documentElement;
        try { if (sessionStorage.getItem('hero-played')) return; } catch (e) {}
        if (!window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('hero-anim');
        setTimeout(function () { if (!window.__heroStarted) d.classList.remove('hero-anim'); }, 1500);
      })();
    </script>
    <div class="hero-main">
      <Label accent="red">systems engineer · web builder · lean six sigma · ai</Label>
      <h1 class="hero-h1">
        <span class="ln"><span>build systems<span class="dot">.</span></span></span>
        <span class="ln"><span>ship tools<span class="dot">.</span></span></span>
        <span class="ln"><span>share the work<span class="dot">.</span><span class="cursor" aria-hidden="true"></span></span></span>
      </h1>
      <p class="hero-sub">
        Industrial engineer who thinks in systems — fixing broken processes by day,
        shipping the tools publicly at night. Building in the open.
      </p>
      <div class="hero-cta">
        <Button href="#work">see the work →</Button>
        <Button href="#writing" variant="ghost">read field notes</Button>
        <span class="hero-sep" aria-hidden="true"></span>
        {social.map(({ label, icon, href }) => {
          const isExternal = !href.startsWith('mailto:');
          return (
            <a
              class="icon-btn"
              href={href}
              aria-label={label}
              title={label}
              {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <Icon name={icon} size={18} />
            </a>
          );
        })}
      </div>
    </div>
    <figure class="hero-term" aria-label="Build log: define, measure, analyze, improve, control, ship">
      <figcaption class="term-head"><span>~/nidhy.dev</span><span>process.log</span></figcaption>
      <pre><span class="tl"><b>$</b> run --method dmaic</span>{'\n'}{logSteps.map(({ step, what }) => (
        <><span class="tl"><em>{step}</em>{what} <u>[ok]</u></span>{'\n'}</>
      ))}<span class="tl"><b>$</b> <span class="tcur" aria-hidden="true"></span></span></pre>
    </figure>
  </section>

  <!-- Work -->
  <section id="work" class="section">
    <div class="container">
      <div class="section-rule"><span>selected work</span></div>
      <div class="projects-grid">
        {featuredProjects.map((p) => (
          <article class="project-card" style={`border-top: 3px solid ${liftColors[p.data.lift] ?? liftColors.default}; --lift-color: ${liftColors[p.data.lift] ?? liftColors.default}`}>
            <h3 class="project-name">{p.data.name}</h3>
            <div class="project-tags">
              {p.data.tags.map((t: string) => <Chip variant="outline">{t}</Chip>)}
            </div>
            <p class="project-blurb">{p.data.blurb}</p>
            {p.data.status === 'coming-soon' ? (
              <span class="coming-soon">article in progress</span>
            ) : (
              <Button href={p.data.href} variant="ghost" size="sm">
                read case study →
              </Button>
            )}
          </article>
        ))}
      </div>
      <div class="all-projects">
        <a href="/projects" class="all-projects-link">all projects →</a>
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section id="writing" class="section section--ink">
    <div class="container">
      <h2 class="writing-heading">field notes</h2>
      <div class="posts">
        {recentPosts.map((post, i) => (
          <div>
            {post.data.published ? (
              <a href={`/writing/${post.id}/`} class="post-row post-row--published">
                <span class="post-date post-date--published">
                  {post.data.date.toISOString().slice(0, 10).replace(/-/g, '.')}
                </span>
                <span class="post-title">{post.data.title}</span>
                <span class="post-tag">#{post.data.tag}</span>
              </a>
            ) : (
              <div class="post-row post-row--draft">
                <span class="post-date post-date--draft">
                  {post.data.date.toISOString().slice(0, 10).replace(/-/g, '.')}
                </span>
                <span class="post-title">{post.data.title}</span>
                <span class="post-drafting">drafting</span>
              </div>
            )}
            {i < recentPosts.length - 1 && <hr class="post-divider" />}
          </div>
        ))}
      </div>
      <div class="all-writing">
        <a href="/writing/" class="all-writing-link">all field notes →</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="container">
      <div class="section-rule"><span>about</span></div>
      <div class="spec">
        <div class="spec-photo">
          <div class="photo">
            <img src="/images/about/nidhin-square-800.jpg" alt="Nidhin smiling in the cockpit of a small plane, wearing a headset and sunglasses" width="800" height="800" loading="lazy" decoding="async" />
          </div>
          <span class="callout callout--1"><i>01</i> thinks in systems</span>
          <span class="callout callout--2"><i>02</i> fixes the root</span>
          <span class="callout callout--3"><i>03</i> ships in public</span>
        </div>

        <div class="spec-info">
          <span class="spec-label">spec sheet · rev. 2026</span>
          <h2 class="spec-headline">root cause<span class="dot">:</span><br />curiosity<span class="dot">.</span></h2>
          <p class="spec-tagline">continuous improvement, continuously deployed.</p>
          <p class="spec-bio">
            <strong>Hi, I'm Nidhin. Welcome to nidhy.dev.</strong>{' '}
            I work where quality, manufacturing and operations meet, and lately IT operations too.
            For 5+ years I've been finding the bottleneck, measuring it, and building the tool that
            keeps it fixed. At night I build in the open and write it up as field notes.
          </p>
          <a class="spec-status" href="/writing/"><span class="status-dot" aria-hidden="true"></span><b>status</b>writing field notes about my career →</a>

          <table class="spec-table">
            <tr><th scope="row">role</th><td>Industrial engineer · quality · manufacturing · operations · IT operations</td></tr>
            <tr><th scope="row">toolkit</th><td>Six Sigma · DMAIC · VSM · 5S · SPC · FMEA · Power BI · Minitab · Claude · Ollama</td></tr>
            <tr><th scope="row">stack</th><td>
              <ul class="icon-list">
                <li><Icon name="filetype-html" />HTML</li>
                <li><Icon name="code-slash" />HTMX</li>
                <li><Icon name="filetype-css" />CSS</li>
                <li><Icon name="javascript" />JavaScript</li>
                <li><Icon name="filetype-py" />Python</li>
                <li><Icon name="server" />Node.js</li>
                <li><Icon name="database" />MS SQL Server</li>
                <li><Icon name="fire" />Firebase</li>
                <li><Icon name="git" />Git</li>
              </ul>
            </td></tr>
            <tr><th scope="row">this site</th><td>
              <ul class="icon-list">
                <li><Icon name="robot" />designed and built end to end with AI</li>
                <li><Icon name="claude" />Claude · Astro · GitHub Pages</li>
              </ul>
            </td></tr>
            <tr><th scope="row">open to</th><td>
              <ul class="open-to">
                <li><Icon name="people" />collabs</li>
                <li><Icon name="briefcase" />consulting</li>
                <li><Icon name="mic" />talks</li>
                <li><Icon name="github" />open source</li>
              </ul>
            </td></tr>
            <tr><th scope="row">reach</th><td><a class="spec-email" href="mailto:hello@nidhy.dev"><Icon name="envelope" />hello@nidhy.dev</a></td></tr>
          </table>
        </div>

        <div class="ledger">
          <div class="ledger-head">measured results</div>
          <dl class="ledger-grid">
            <div class="wide"><dt>total savings across projects</dt><dd class="red">$175–250K</dd></div>
            <div><dt>improvement projects delivered</dt><dd>25+</dd></div>
            <div><dt>people using what I've built</dt><dd>250+</dd></div>
            <div><dt>dashboards built</dt><dd class="gold">15+</dd></div>
            <div><dt>in-house cloud apps, built with AI</dt><dd>6</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<script>
  import '../scripts/hero-motion';
</script>

<style>
  .container {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  /* Hero: headline + build-log terminal (motion in src/scripts/hero-motion.ts) */
  .hero {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) 0;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
  }
  .hero-main { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 4.3vw, 52px);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: lowercase;
    margin: 0;
  }
  .hero-h1 .ln { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .hero-h1 .ln > span { display: inline-block; white-space: nowrap; }
  .hero-h1 .dot { display: inline-block; color: var(--blood); }
  .cursor { display: inline-block; width: 0.42em; height: 0.78em; background: var(--ink); margin-left: 0.12em; vertical-align: -0.02em; animation: blink 1.1s steps(1) infinite; }
  .hero-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.45;
    max-width: 48ch;
    color: var(--ink-60);
    margin: 0;
  }
  .hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .hero-sep { width: 2px; height: 28px; background: var(--ink-30); margin: 0 4px; }
  .icon-btn {
    width: 42px;
    height: 42px;
    display: inline-grid;
    place-items: center;
    border: 2px solid var(--ink);
    color: var(--ink);
    transition: transform 0.1s, box-shadow 0.1s, background 0.1s, color 0.1s;
  }
  .icon-btn:hover { background: var(--ink); color: var(--paper); transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--blood); }
  .icon-btn:active { transform: translate(2px, 2px); box-shadow: none; }

  .hero-term { margin: 0; background: var(--ink); color: var(--paper); border: var(--border); box-shadow: 8px 8px 0 var(--blood); min-width: 0; }
  .term-head { display: flex; justify-content: space-between; border-bottom: 2px solid rgba(232, 228, 216, 0.25); font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; padding: 8px 12px; color: rgba(232, 228, 216, 0.7); }
  .hero-term pre { margin: 0; padding: 18px 16px 22px; font: 13px/1.9 var(--font-mono); white-space: pre; overflow-x: auto; }
  .hero-term .tl { display: inline-block; }
  .hero-term b { color: var(--gold); }
  .hero-term em { font-style: normal; font-weight: 700; }
  .hero-term u { text-decoration: none; color: var(--signal); font-weight: 700; }
  .tcur { display: inline-block; width: 0.6em; height: 1.1em; background: var(--paper); vertical-align: -0.2em; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* starting states, only while the intro is about to play (html.hero-anim, set inline above) */
  :global(.hero-anim) .hero-h1 .ln > span { transform: translateY(105%); }
  :global(.hero-anim) .hero-h1 .dot,
  :global(.hero-anim) .hero :global(.label),
  :global(.hero-anim) .hero-sub,
  :global(.hero-anim) .hero-cta > :global(*),
  :global(.hero-anim) .hero-term .tl { opacity: 0; }

  /* Sections */
  .section { padding: var(--space-6) 0; }
  .section--ink { background: var(--ink); color: var(--paper); }
  .section-rule {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    border-top: var(--border);
    padding-top: var(--space-2);
  }
  .section-rule span {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: var(--ink-60);
    white-space: nowrap;
  }

  /* Projects */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  .project-card {
    background: var(--paper-2);
    border: var(--border);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform 0.15s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.15s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--lift-color);
  }
  .project-name {
    font-family: var(--font-display);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.1;
    text-transform: lowercase;
  }
  .project-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .project-blurb {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-70);
    flex: 1;
  }
  .coming-soon {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-60);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    border-top: 1px dashed var(--ink-60);
    padding-top: 10px;
    display: block;
  }

  .all-projects { margin-top: var(--space-4); }
  .all-projects-link {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink);
    text-decoration: none;
    border: var(--border);
    padding: 10px 20px;
    display: inline-block;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .all-projects-link:hover { background: var(--ink); color: var(--paper); }

  /* Writing section */
  .writing-heading {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 40px);
    line-height: 0.95;
    margin-bottom: var(--space-4);
    color: var(--paper);
    text-wrap: balance;
    text-transform: lowercase;
  }
  .posts { margin-bottom: var(--space-4); }
  .post-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 18px 0;
    text-decoration: none;
  }
  .post-row--published {
    color: var(--paper);
    cursor: pointer;
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .post-row--published:hover { transform: translateX(-6px); }
  .post-row--draft { color: rgba(232,228,216,0.4); cursor: default; }
  .post-date { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; min-width: 92px; }
  .post-date--published { color: var(--gold); }
  .post-date--draft { color: rgba(232,228,216,0.3); }
  .post-title { font-family: var(--font-serif); font-style: italic; font-size: clamp(16px, 2vw, 22px); flex: 1; }
  .post-tag { font-family: var(--font-mono); font-size: 11px; color: rgba(232,228,216,0.6); }
  .post-drafting { font-family: var(--font-mono); font-size: 10px; color: rgba(232,228,216,0.35); text-transform: uppercase; letter-spacing: 0.2em; }
  .post-divider { border: none; border-top: 2px dashed rgba(232,228,216,0.25); margin: 0; }
  .all-writing { margin-bottom: var(--space-4); }
  .all-writing-link {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--paper);
    text-decoration: none;
    border: 2px solid var(--paper);
    padding: 10px 20px;
    display: inline-block;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .all-writing-link:hover { background: var(--paper); color: var(--ink); }
  .subscribe { margin-top: var(--space-5); }
  .subscribe-label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; color: rgba(232,228,216,0.5); margin-bottom: var(--space-2); }
  .subscribe-soon { font-family: var(--font-serif); font-style: italic; font-size: 14px; color: rgba(232,228,216,0.4); margin: 0; }
  .beehiiv-embed { border: none; overflow: hidden; width: 100%; height: 52px; }

  /* About — spec sheet */
  .spec {
    display: grid;
    grid-template-columns: 5fr 7fr;
    grid-template-rows: auto 1fr;
    grid-template-areas: "photo info" "ledger info";
    column-gap: var(--space-5);
    row-gap: var(--space-4);
  }
  .spec-photo { grid-area: photo; position: relative; padding-right: var(--space-3); }
  .spec-info { grid-area: info; }
  .ledger { grid-area: ledger; align-self: end; margin-right: var(--space-3); }

  /* photo: grayscale on paper + faint halftone, framed with a hard shadow */
  .photo { position: relative; aspect-ratio: 1; border: var(--border); background: var(--paper); box-shadow: var(--shadow-red); overflow: hidden; }
  .photo img { display: block; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.25) brightness(1.08); mix-blend-mode: multiply; }
  .photo::after { content: ''; position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(var(--ink) 22%, transparent 23%); background-size: 4px 4px; opacity: 0.14; mix-blend-mode: multiply; }
  .callout { position: absolute; display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; background: var(--paper); border: 2px solid var(--ink); padding: 4px 8px; white-space: nowrap; }
  .callout i { font-style: normal; font-family: var(--font-display); font-size: 16px; color: var(--blood); letter-spacing: 0; }
  .callout--1 { top: 12%; right: 0; }
  .callout--2 { top: 46%; left: -12px; }
  .callout--3 { bottom: 8%; right: var(--space-2); }

  .spec-label { display: inline-block; font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.25em; text-transform: uppercase; color: var(--blood); padding: 4px 10px; border: 1.5px solid currentColor; }
  .spec-headline { font-family: var(--font-display); font-weight: 400; font-size: clamp(30px, 4vw, 44px); line-height: 0.95; text-transform: lowercase; margin: var(--space-2) 0 var(--space-1); }
  .spec-headline .dot { color: var(--blood); }
  .spec-tagline { font-family: var(--font-serif); font-style: italic; font-size: clamp(17px, 1.8vw, 20px); line-height: 1.3; color: var(--ink-60); margin: 0 0 var(--space-3); }
  .spec-bio { font-size: 15px; line-height: 1.6; margin: 0 0 var(--space-3); max-width: 60ch; }
  .spec-bio strong { font-weight: 700; }
  .spec-status { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; border: 2px solid var(--ink); padding: 8px 12px; font-family: var(--font-mono); font-size: 13px; color: var(--ink); text-decoration: none; }
  .spec-status:hover { border-color: var(--blood); color: var(--blood); }
  .spec-status b { font-size: 11px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--signal); }
  .status-dot { width: 10px; height: 10px; background: var(--signal); flex-shrink: 0; }

  .spec-table { width: 100%; border-collapse: collapse; margin-top: var(--space-3); font-size: 13px; }
  .spec-table th { text-align: left; vertical-align: top; width: 130px; padding: 12px 16px 12px 0; font-size: 11px; font-weight: 700; letter-spacing: 0.25em; text-transform: uppercase; color: var(--ink-60); border-bottom: var(--divider-dashed); }
  .spec-table td { padding: 12px 0; line-height: 1.5; border-bottom: var(--divider-dashed); }
  .icon-list, .open-to { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; }
  .icon-list { gap: 8px 16px; }
  .icon-list li { display: inline-flex; align-items: center; gap: 6px; }
  .open-to { gap: 6px; }
  .open-to li { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; border: 2px solid var(--ink); padding: 5px 10px; }
  .spec-email { display: inline-flex; align-items: center; gap: 8px; color: var(--blood); font-weight: 700; text-decoration: none; }
  .spec-email:hover { text-decoration: underline; }
  .spec-table :global(svg) { width: 15px; height: 15px; flex-shrink: 0; }

  .ledger { border: var(--border); background: var(--paper); }
