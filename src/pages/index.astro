---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Label from '../components/Label.astro';
import Button from '../components/Button.astro';
import Chip from '../components/Chip.astro';
import Panel from '../components/Panel.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('writing');
const recentPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

const projects = [
  {
    name: 'real-time spc system',
    lift: 'red' as const,
    tags: ['powerbi', 'sql', 'python'],
    blurb: 'Built real-time Statistical Process Control dashboards for 3 production lines. Achieved $70–85K annual savings and 30–40% scrap reduction.',
    type: 'article',
    href: '#',
    comingSoon: true,
  },
  {
    name: 'digital inspection platform',
    lift: 'green' as const,
    tags: ['powerbi', 'automation', 'leadership'],
    blurb: 'Coordinated 4 departments to design and deploy a digital quality inspection system serving 40+ users. Delivered $30K+ annual savings.',
    type: 'article',
    href: '#',
    comingSoon: true,
  },
  {
    name: 'process optimization suite',
    lift: 'gold' as const,
    tags: ['lean', 'dmaic', 'vsmapping'],
    blurb: 'Led cross-functional Kaizen events and Value Stream Mapping initiatives. Reduced cycle time 15%, eliminated $90K in annual waste.',
    type: 'article',
    href: '#',
    comingSoon: true,
  },
];

const liftColors = { red: 'var(--blood)', green: 'var(--signal)', gold: 'var(--gold)' };

const social = [
  { label: 'github', href: 'https://github.com/crackcode09' },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/dnidhin97/' },
  { label: 'email', href: 'mailto:dileepkumarnidhin@outlook.com' },
];
---

<Base>
  <Header />

  <!-- Hero -->
  <section id="top" class="hero">
    <Label accent="red">systems engineer · web builder · lean six sigma · ai</Label>
    <h1 class="hero-h1">
      build systems<span class="dot">.</span><br />
      ship tools<span class="dot">.</span><br />
      share the work<span class="dot">.</span>
    </h1>
    <p class="hero-sub">
      Industrial engineer who thinks in systems — fixing broken processes by day,
      shipping the tools publicly at night. Building in the open.
    </p>
    <div class="hero-cta">
      <Button href="#work">see the work →</Button>
      <Button href="#writing" variant="ghost">read field notes</Button>
    </div>
    <div class="hero-social">
      {social.map(({ label, href }) => {
        const isExternal = !href.startsWith('mailto:');
        return (
          <a
            href={href}
            aria-label={label}
            {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {label} →
          </a>
        );
      })}
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="section">
    <div class="container">
      <div class="section-rule"><span>selected work</span></div>
      <div class="projects-grid">
        {projects.map((p) => (
          <article class="project-card" style={`border-top: 3px solid ${liftColors[p.lift]}; --lift-color: ${liftColors[p.lift]}`}>
            <h3 class="project-name">{p.name}</h3>
            <div class="project-tags">
              {p.tags.map((t) => <Chip variant="outline">{t}</Chip>)}
            </div>
            <p class="project-blurb">{p.blurb}</p>
            {p.comingSoon ? (
              <span class="coming-soon">article in progress</span>
            ) : (
              <Button href={p.href} variant="ghost" size="sm">
                read case study →
              </Button>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section id="writing" class="section section--ink">
    <div class="container">
      <h2 class="writing-heading">field notes</h2>
      <div class="posts">
        {recentPosts.map((post, i) => (
          <div>
            {post.data.published ? (
              <a href={`/writing/${post.id}/`} class="post-row post-row--published">
                <span class="post-date post-date--published">
                  {post.data.date.toISOString().slice(0, 10).replace(/-/g, '.')}
                </span>
                <span class="post-title">{post.data.title}</span>
                <span class="post-tag">#{post.data.tag}</span>
              </a>
            ) : (
              <div class="post-row post-row--draft">
                <span class="post-date post-date--draft">
                  {post.data.date.toISOString().slice(0, 10).replace(/-/g, '.')}
                </span>
                <span class="post-title">{post.data.title}</span>
                <span class="post-drafting">drafting</span>
              </div>
            )}
            {i < recentPosts.length - 1 && <hr class="post-divider" />}
          </div>
        ))}
      </div>
      <div class="all-writing">
        <a href="/writing/" class="all-writing-link">all field notes →</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="container">
      <div class="section-rule"><span>about</span></div>
      <div class="about-grid">
        <div class="about-left">
          <p class="about-bio">
            I'm Nidhin — industrial engineer, systems thinker, AI builder. I fix broken processes
            and build the tools to prove it. Four years in manufacturing CI; building in the open
            at night. I use AI to build faster and I share everything publicly.
          </p>
          <blockquote class="about-quote">
            "Every broken process is a signal the system is speaking. Listen, measure, fix the root — not the symptom."
          </blockquote>
          <div class="about-subsection">
            <p class="about-subsection-label">outside the work</p>
            <p class="about-outside">
              Travel · photography · gaming. Currently adding gym and swimming to the rotation. Staying curious is the default.
            </p>
          </div>
          <div class="about-subsection">
            <p class="about-subsection-label">open to</p>
            <div class="about-chips">
              <Chip variant="outline">collabs</Chip>
              <Chip variant="outline">consulting</Chip>
              <Chip variant="outline">talks</Chip>
              <Chip variant="outline">open source</Chip>
            </div>
            <p class="about-contact">
              reach out → <a href="mailto:dileepkumarnidhin@outlook.com" class="about-email">dileepkumarnidhin@outlook.com</a>
            </p>
          </div>
        </div>
        <div class="about-right">
          <Panel sunken>
            <Label accent="muted">systems &amp; data</Label>
            <CodeBlock label="stack.toml">{`lean    = "Six Sigma, DMAIC, VSM, 5S"
data    = "Power BI, SQL, Python, Minitab"
quality = "SPC, FMEA, Control Plans"
ai_data = "OpenAI, Claude, Ollama"`}</CodeBlock>
          </Panel>
          <Panel sunken>
            <Label accent="muted">web &amp; build</Label>
            <CodeBlock label="web.toml">{`frontend = "React, Next.js, HTMX, JS"
backend  = "Node.js, Express, Python"
data_viz = "Chart.js, Power BI"
platform = "Supabase, Sanity, EJS"
build_w  = "AI-assisted, shipped publicly"`}</CodeBlock>
          </Panel>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .container {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  /* Hero */
  .hero {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: var(--space-7) var(--space-4) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(40px, 8vw, 96px);
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-transform: lowercase;
    text-wrap: balance;
    margin: var(--space-2) 0;
    max-width: 14ch;
  }
  .hero-h1 .dot { color: var(--blood); }
  .hero-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.45;
    max-width: 52ch;
    color: var(--ink-60);
  }
  .hero-cta { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-2); }
  .hero-social { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-2); }
  .hero-social a {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-60);
    text-decoration: none;
  }
  .hero-social a:hover { color: var(--blood); }

  /* Sections */
  .section { padding: var(--space-6) 0; }
  .section--ink { background: var(--ink); color: var(--paper); }
  .section-rule {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    border-top: var(--border);
    padding-top: var(--space-2);
  }
  .section-rule span {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: var(--ink-60);
    white-space: nowrap;
  }

  /* Projects */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  .project-card {
    background: var(--paper-2);
    border: var(--border);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform 0.15s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.15s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--lift-color);
  }
  .project-name {
    font-family: var(--font-display);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.1;
    text-transform: lowercase;
  }
  .project-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .project-blurb {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-60);
    flex: 1;
  }
  .coming-soon {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-60);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    border-top: 1px dashed var(--ink-60);
    padding-top: 10px;
    display: block;
  }

  /* Writing section */
  .writing-heading {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 40px);
    line-height: 0.95;
    margin-bottom: var(--space-4);
    color: var(--paper);
    text-wrap: balance;
    text-transform: lowercase;
  }
  .posts { margin-bottom: var(--space-4); }
  .post-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 18px 0;
    text-decoration: none;
  }
  .post-row--published {
    color: var(--paper);
    cursor: pointer;
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .post-row--published:hover { transform: translateX(-6px); }
  .post-row--draft { color: rgba(232,228,216,0.4); cursor: default; }
  .post-date { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; min-width: 92px; }
  .post-date--published { color: var(--gold); }
  .post-date--draft { color: rgba(232,228,216,0.3); }
  .post-title { font-family: var(--font-serif); font-style: italic; font-size: clamp(16px, 2vw, 22px); flex: 1; }
  .post-tag { font-family: var(--font-mono); font-size: 11px; color: rgba(232,228,216,0.6); }
  .post-drafting { font-family: var(--font-mono); font-size: 10px; color: rgba(232,228,216,0.35); text-transform: uppercase; letter-spacing: 0.2em; }
  .post-divider { border: none; border-top: 2px dashed rgba(232,228,216,0.25); margin: 0; }
  .all-writing { margin-bottom: var(--space-4); }
  .all-writing-link {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--paper);
    text-decoration: none;
    border: 2px solid var(--paper);
    padding: 10px 20px;
    display: inline-block;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .all-writing-link:hover { background: var(--paper); color: var(--ink); }
  .subscribe { margin-top: var(--space-5); }
  .subscribe-label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; color: rgba(232,228,216,0.5); margin-bottom: var(--space-2); }
  .subscribe-soon { font-family: var(--font-serif); font-style: italic; font-size: 14px; color: rgba(232,228,216,0.4); margin: 0; }
  .beehiiv-embed { border: none; overflow: hidden; width: 100%; height: 52px; }

  /* About */
  .about-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-5); align-items: start; }
  .about-left { display: flex; flex-direction: column; gap: var(--space-3); }
  .about-bio { font-size: 15px; line-height: 1.6; margin: 0; }
  .about-quote { font-family: var(--font-serif); font-style: italic; font-size: 15px; line-height: 1.5; color: var(--ink); border-left: 3px solid var(--signal); padding-left: var(--space-3); margin: 0; }
  .about-subsection { border-top: var(--border); padding-top: var(--space-3); display: flex; flex-direction: column; gap: var(--space-2); }
  .about-subsection-label { font-family: var(--font-mono); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3em; color: var(--ink-60); margin: 0; }
  .about-outside { font-size: 14px; line-height: 1.6; color: var(--ink-60); margin: 0; }
  .about-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .about-contact { font-family: var(--font-mono); font-size: 13px; color: var(--ink-60); margin: 0; }
  .about-email { color: var(--blood); text-decoration: none; font-weight: 700; }
  .about-right { display: flex; flex-direction: column; gap: var(--space-3); }

  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-row, .project-card { transition: none; }
    .post-row--published:hover { transform: none; }
    .project-card:hover { transform: none; box-shadow: none; }
  }
</style>
