---
import { Font } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  author?: string;
  publishedTime?: string;
}

const {
  title = 'nidhin dileepkumar',
  description = 'systems engineer · web builder · lean six sigma · ai. building in the open.',
  image = '/og/default.png',
  author,
  publishedTime,
} = Astro.props;

const site = 'https://nidhy.dev';
const ogImage = new URL(image, site).href;
const ogUrl = new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content={publishedTime ? 'article' : 'website'} />
    <meta property="og:site_name" content="nidhy.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {author && <meta name="author" content={author} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://subscribe-forms.beehiiv.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://embeds.beehiiv.com https://subscribe-forms.beehiiv.com; connect-src https://subscribe-forms.beehiiv.com https://api.beehiiv.com; img-src 'self' data: https://*.beehiiv.com;"
    />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b0e0d" />
    <!-- preload what the first screen needs; italic and serif files load on demand -->
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-serif" />
  </head>
  <body>
    <a class="skip-link" href="#work">skip to content</a>
    <slot />
    <script>
      // Smooth-scroll only for links to a section on the current page. Arriving from
      // another page (e.g. /writing/ → /#about) jumps straight there, with no visible
      // scroll through the whole page. Reduced motion always jumps.
      document.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = (event.target as Element).closest('a[href*="#"]') as HTMLAnchorElement | null;
        if (!link || link.classList.contains('skip-link')) return;
        const url = new URL(link.href);
        if (url.origin !== location.origin || url.pathname !== location.pathname || !url.hash) return;
        const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
        if (!target) return;
        event.preventDefault();
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
        history.pushState(null, '', url.hash);
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* reserve the scrollbar's space on every page, so short pages (no scrollbar) and
     long pages line up and nothing jumps sideways between them */
  html { overflow-x: hidden; scrollbar-gutter: stable; }


  /* cross-fade between pages; header and footer stay put. Browsers without
     support load pages as before. */
  @view-transition { navigation: auto; }
  header { view-transition-name: site-header; }
  footer { view-transition-name: site-footer; }
  ::view-transition-old(root),
  ::view-transition-new(root) { animation-duration: 0.2s; }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) { animation: none !important; }
  }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
    /* column layout so the footer sits at the bottom of short pages */
    display: flex;
    flex-direction: column;
  }
  /* sections keep their own max-width + auto margins; full width by default */
  body > :not(.skip-link) { width: 100%; }
  body > footer { margin-top: auto; }

  button:focus, a:focus { outline: 3px solid var(--blood); outline-offset: 2px; }
  input:focus { outline: 3px solid var(--ink); outline-offset: 2px; }

  .skip-link {
    position: absolute;
    top: -999px;
    left: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 8px 16px;
    z-index: 9999;
    text-decoration: none;
  }
  .skip-link:focus { top: 0; }
</style>
