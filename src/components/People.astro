---
// Collaborators on a post or project (src/content/people). `full` shows photo, name,
// role and link; `compact` is a row of small photos and names for project cards.
import { Image } from 'astro:assets';
import { getEntries } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  people: { collection: 'people'; id: string }[];
  label?: string;
  variant?: 'full' | 'compact';
}
const { people: refs, label = 'written with', variant = 'full' } = Astro.props;
const people = (await getEntries(refs)) as CollectionEntry<'people'>[];
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---
{people.length > 0 && (variant === 'full' ? (
  <section class="people" aria-label={label}>
    <h2 class="people-label">{label}</h2>
    <ul class="people-list">
      {people.map(({ data }) => (
        <li class="person">
          <span class="ph" aria-hidden="true">
            {data.photo ? <Image src={data.photo} alt="" width={128} height={128} /> : initials(data.name)}
          </span>
          <span class="who">
            {data.link
              ? <a href={data.link} target="_blank" rel="noopener noreferrer" class="name">{data.name} ↗</a>
              : <span class="name">{data.name}</span>}
            <span class="role">{data.role}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>
) : (
  <p class="people-compact">
    <span class="people-label">{label}</span>
    {people.map(({ data }) => (
      <span class="mini">
        <span class="ph ph--sm" aria-hidden="true">
          {data.photo ? <Image src={data.photo} alt="" width={48} height={48} /> : initials(data.name)}
        </span>
        {data.name}
      </span>
    ))}
  </p>
))}

<style>
  .people { border-top: var(--border); padding-top: var(--space-3); margin-bottom: var(--space-5); }
  .people-label { font-family: var(--font-mono); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; color: var(--ink-60); margin: 0 0 var(--space-2); }
  .people-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-2); }
  .person { display: flex; align-items: center; gap: 14px; }
  /* same grayscale, halftone treatment as the About photo */
  .ph { position: relative; flex: none; width: 64px; height: 64px; display: grid; place-items: center; border: 2px solid var(--ink); background: var(--paper-2); box-shadow: 3px 3px 0 var(--blood); overflow: hidden; font-family: var(--font-display); font-size: 20px; text-transform: lowercase; }
  .ph :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.25) brightness(1.08); mix-blend-mode: multiply; }
  .ph::after { content: ''; position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(var(--ink) 22%, transparent 23%); background-size: 4px 4px; opacity: 0.14; mix-blend-mode: multiply; }
  .who { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .name { font-family: var(--font-mono); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink); text-decoration: none; }
  a.name:hover { color: var(--blood); }
  .role { font-family: var(--font-serif); font-style: italic; font-size: 15px; color: var(--ink-60); }

  .people-compact { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 0; }
  .people-compact .people-label { margin: 0; font-size: 10px; }
  .mini { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .ph--sm { width: 24px; height: 24px; border-width: 1.5px; box-shadow: none; font-size: 10px; }
</style>
