---
// "sources" list at the end of a field note: logo (optional) + site name + link.
// Logos are saved in the repo, because the CSP only allows images from nidhy.dev.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  sources: { name: string; url: string; logo?: ImageMetadata }[];
}
const { sources } = Astro.props;
const host = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---
{sources.length > 0 && (
  <section class="sources" aria-labelledby="sources-heading">
    <h2 id="sources-heading" class="sources-label">sources</h2>
    <ol class="sources-list">
      {sources.map(({ name, url, logo }) => (
        <li>
          <a href={url} target="_blank" rel="noopener noreferrer">
            <span class="logo" aria-hidden="true">
              {logo ? <Image src={logo} alt="" width={64} height={64} fit="contain" /> : name.trim().charAt(0)}
            </span>
            <span class="text"><b>{name}</b><span class="host">{host(url)} ↗</span></span>
          </a>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .sources { border-top: var(--border); padding-top: var(--space-3); margin-bottom: var(--space-5); }
  .sources-label { font-family: var(--font-mono); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; color: var(--ink-60); margin: 0 0 var(--space-2); }
  .sources-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .sources-list a { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); border: 2px solid var(--ink); padding: 8px 12px 8px 8px; background: var(--paper); transition: transform 0.1s, box-shadow 0.1s; }
  .sources-list a:hover { transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--blood); }
  .logo { flex: none; width: 32px; height: 32px; display: grid; place-items: center; background: var(--paper-2); border: 1px solid var(--ink-12); font-family: var(--font-display); font-size: 16px; text-transform: lowercase; overflow: hidden; }
  .logo :global(img) { width: 24px; height: 24px; object-fit: contain; }
  .text { display: flex; flex-direction: column; min-width: 0; }
  .text b { font-family: var(--font-serif); font-weight: 600; font-size: 16px; line-height: 1.3; }
  .host { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; color: var(--ink-60); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) {
    .sources-list a { transition: none; }
    .sources-list a:hover { transform: none; }
  }
</style>
