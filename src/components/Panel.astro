---
interface Props {
  sunken?: boolean;
}
const { sunken = false } = Astro.props;
---
<div class:list={['panel', { 'panel--sunken': sunken }]}>
  <slot />
</div>
<style>
  .panel {
    background: var(--paper-2);
    border: var(--border);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .panel--sunken {
    background: var(--paper);
    box-shadow: inset 0 2px 6px rgba(11,14,13,0.08);
  }
</style>
