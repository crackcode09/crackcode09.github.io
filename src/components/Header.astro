---
import Wordmark from './Wordmark.astro';
import Button from './Button.astro';
---
<header>
  <div class="header-inner">
    <a href="/" aria-label="nidhin.dev home" class="wordmark-link">
      <Wordmark />
    </a>
    <nav id="main-nav">
      <a href="/#work">work</a>
      <a href="/#writing">writing</a>
      <a href="/#about">about</a>
      <Button href="/#writing" size="sm" class="subscribe-btn">subscribe</Button>
    </nav>
    <button class="hamburger" id="hamburger" aria-label="open menu" aria-expanded="false" aria-controls="main-nav">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <a href="/#work">work</a>
    <a href="/#writing">writing</a>
    <a href="/#about">about</a>
    <a href="/#writing" class="mobile-subscribe">subscribe</a>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  hamburger?.addEventListener('click', () => {
    const open = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', String(!open));
    hamburger.classList.toggle('is-open', !open);
    mobileMenu?.classList.toggle('is-open', !open);
    mobileMenu?.setAttribute('aria-hidden', String(open));
  });

  // Close menu when a link is clicked
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      hamburger?.setAttribute('aria-expanded', 'false');
      hamburger?.classList.remove('is-open');
      mobileMenu.classList.remove('is-open');
      mobileMenu.setAttribute('aria-hidden', 'true');
    });
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper);
    border-bottom: var(--border);
  }
  .header-inner {
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 18px var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark-link { text-decoration: none; }
  nav { display: flex; align-items: center; gap: var(--space-3); }
  nav a:not(.btn) {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink);
    text-decoration: none;
  }
  nav a:not(.btn):hover { color: var(--blood); }
  nav :global(.subscribe-btn) { background: var(--blood); border-color: var(--blood); color: var(--paper); }
  nav :global(.subscribe-btn:hover) { background: var(--ink); border-color: var(--ink); }

  /* Hamburger button — hidden on desktop */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .hamburger span {
    display: block;
    width: 100%;
    height: 3px;
    background: var(--ink);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .hamburger.is-open span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .hamburger.is-open span:nth-child(2) { opacity: 0; }
  .hamburger.is-open span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  /* Mobile dropdown menu */
  .mobile-menu {
    display: none;
    flex-direction: column;
    background: var(--paper);
    border-top: var(--border);
    padding: var(--space-2) var(--space-2);
    gap: 0;
  }
  .mobile-menu.is-open { display: flex; }
  .mobile-menu a {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink);
    text-decoration: none;
    padding: 14px 0;
    border-bottom: 1px solid var(--ink-12);
  }
  .mobile-menu a:last-child { border-bottom: none; }
  .mobile-menu a:hover { color: var(--blood); }
  .mobile-menu .mobile-subscribe {
    color: var(--paper);
    background: var(--blood);
    text-align: center;
    padding: 12px;
    margin-top: var(--space-2);
    border-bottom: none;
  }
  .mobile-menu .mobile-subscribe:hover { background: var(--ink); color: var(--paper); }

  @media (max-width: 540px) {
    nav a { display: none; }
    nav :global(.btn) { display: none; }
    .hamburger { display: flex; }
    .header-inner { padding: 18px var(--space-2); }
  }
</style>
