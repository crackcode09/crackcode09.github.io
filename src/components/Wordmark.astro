---
interface Props {
  size?: number;
  onInk?: boolean;
  loading?: 'eager' | 'lazy';
}
const { size = 24, onInk = false, loading = 'eager' } = Astro.props;
const iconSize = Math.round(size * 0.85);
---
<span
  class="wordmark"
  style={`color: ${onInk ? 'var(--paper)' : 'var(--ink)'}`}
>
  <img src="/favicon.svg" alt="" width={iconSize} height={iconSize} class="wordmark-icon" loading={loading} />
  <span class="wordmark-text" style={`font-size: ${size}px`}>nidhy<span class="dot">.</span>dev</span>
</span>
<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    line-height: 1;
    user-select: none;
  }
  .wordmark-icon { display: block; flex-shrink: 0; }
  .wordmark-text {
    font-family: var(--font-display);
    line-height: 1;
    text-transform: lowercase;
  }
  .dot { color: var(--blood); }
</style>
